# ==============================================================================
# smartImpact — Environment Configuration Template
#
# KEAMANAN & ARSITEKTUR VERCEL:
# 1. JANGAN PERNAH menaruh Blynk Auth Token di variabel berawalan VITE_*.
#    Semua variabel VITE_* akan di-bundle ke file JS client yang bisa dibaca publik.
# 2. Untuk VERCEL (Production):
#    Masukkan BLYNK_AUTH_TOKEN di Vercel Dashboard -> Settings -> Environment Variables.
# 3. Untuk PENGEMBANGAN LOKAL (Development):
#    Salin variabel di bawah ini ke file .env.local (file ini otomatis diabaikan git).
# ==============================================================================

# --- KREDENSIAL SERVER-SIDE (Vercel Serverless / .env.local) ---
# Token rahasia perangkat ESP32 dari Blynk Cloud Console
BLYNK_AUTH_TOKEN=your_blynk_auth_token_here

# Domain server Blynk yang digunakan (blynk.cloud atau sgp1.blynk.cloud)
BLYNK_SERVER=blynk.cloud

# Identitas perangkat
DEVICE_NAME=ESP32
DEVICE_ID=ESP32-001
DEVICE_LOCATION=Politeknik Negeri Banyuwangi

# --- FRONTEND CLIENT OPTIONS (Aman dibaca browser) ---
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=8000
